<mxfile host="app.diagrams.net"><diagram name="Detailed Design Class Diagram"><mxGraphModel page="1" pageWidth="1169" pageHeight="827" grid="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Study Session Finder: AI Assistant&lt;/b&gt;&lt;br&gt;Detailed Design Class Diagram | Deliverable 05" style="text;html=1;align=center;fontSize=22;" vertex="1" parent="1"><mxGeometry x="100" y="20" width="900" height="65" as="geometry" /></mxCell><mxCell id="ui" value="&lt;b&gt;AIHelper (client component)&lt;/b&gt;&lt;hr&gt;- question: string&lt;br&gt;- answer: string&lt;br&gt;- loading: boolean&lt;hr&gt;+ submitQuestion(): void&lt;br&gt;+ renderAnswer(): void" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=14;strokeColor=#666666;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="280" height="180" as="geometry" /></mxCell><mxCell id="action" value="&lt;b&gt;AIAction (server module)&lt;/b&gt;&lt;hr&gt;+ askQuestion(question: string): string&lt;br&gt;+ buildContext(sessions): string" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=14;strokeColor=#666666;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="300" height="150" as="geometry" /></mxCell><mxCell id="api" value="&lt;b&gt;PatriotAIClient (server module)&lt;/b&gt;&lt;hr&gt;+ requestAnswer(question, context): string" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=14;strokeColor=#666666;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="830" y="130" width="280" height="130" as="geometry" /></mxCell><mxCell id="db" value="&lt;b&gt;db.js (existing server module)&lt;/b&gt;&lt;hr&gt;+ getSessions(): SessionResult[]" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=14;strokeColor=#666666;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="440" y="400" width="300" height="120" as="geometry" /></mxCell><mxCell id="session" value="&lt;b&gt;SessionResult&lt;/b&gt;&lt;hr&gt;sessionID: integer&lt;br&gt;sessionTitle: string&lt;br&gt;courseName: string&lt;br&gt;meetingTime: string&lt;br&gt;location: string&lt;br&gt;studyStyle: string&lt;br&gt;capacity: integer" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=14;strokeColor=#666666;fillColor=#e2f0d9;" vertex="1" parent="1"><mxGeometry x="440" y="600" width="300" height="190" as="geometry" /></mxCell><mxCell id="e1" source="ui" target="action" value="calls" edge="1" parent="1" style="endArrow=open;dashed=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" source="action" target="api" value="requests answer" edge="1" parent="1" style="endArrow=open;dashed=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" source="action" target="db" value="retrieves sessions" edge="1" parent="1" style="endArrow=open;dashed=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" source="db" target="session" value="returns 0..*" edge="1" parent="1" style="endArrow=open;dashed=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note" value="Proposed design for Issue #54.&lt;br&gt;New module names and method signatures are illustrative.&lt;br&gt;API credentials remain on the server.&lt;br&gt;Session data comes from SQLite." style="text;html=1;align=left;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="430" width="300" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>